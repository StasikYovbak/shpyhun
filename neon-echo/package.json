{
  "name": "neon-echo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ЕХО: неоновий кур'єр — піксельний кіберпанк-платформер (Vite + PixiJS + Capacitor)",
  "license": "MIT",
  "scripts": {
    "assets": "node tools/gen-assets.mjs && node tools/gen-audio.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && vite build",
    "preview": "vite preview --port 4173",
    "sync": "npm run build && npx cap sync android && node tools/patch-android.mjs",
    "apk:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run sync && cd android && ./gradlew assembleRelease",
    "test": "node tests/run-all.mjs",
    "check:release": "node tools/check-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/screen-orientation": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@fontsource/handjet": "^5.3.0",
    "howler": "^2.2.4",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.20.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
