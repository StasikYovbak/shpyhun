<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hud"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.15"
            android:shadowColor="@color/jarvis_cyan"
            android:shadowRadius="16"
            android:text="ПІДГОТОВКА СИСТЕМ"
            android:textColor="@color/jarvis_cyan"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Jarvis.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="Джарвісу потрібні кілька дозволів. Біля кожного — пояснення, навіщо він. Обов'язкові — мікрофон, сповіщення й робота у фоні; решта вмикає окремі команди."
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/torchNote"
            style="@style/Jarvis.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jarvis_text_dim"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVendor"
            style="@style/Jarvis.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Xiaomi / Samsung: щоб не вбивали у фоні" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="Готово"
            android:textSize="17sp" />
    </LinearLayout>
</ScrollView>
