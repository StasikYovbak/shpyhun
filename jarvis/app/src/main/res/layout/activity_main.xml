<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hud"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Верхня панель -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.3"
                    android:shadowColor="@color/jarvis_cyan"
                    android:shadowRadius="20"
                    android:text="J.A.R.V.I.S."
                    android:textColor="@color/jarvis_cyan"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:text="Just A Rather Very Intelligent System"
                    android:textColor="@color/jarvis_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnPermissions"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/permissions"
                android:src="@drawable/ic_shield" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Підказка, що ще не налаштовано -->
        <TextView
            android:id="@+id/setupBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_banner"
            android:padding="12dp"
            android:textColor="@color/jarvis_amber"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Реактор-індикатор -->
        <ua.jarvis.assistant.ui.ArcReactorView
            android:id="@+id/reactor"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:letterSpacing="0.2"
            android:shadowColor="@color/jarvis_cyan"
            android:shadowRadius="16"
            android:text="ВИМКНЕНО"
            android:textColor="@color/jarvis_text_dim"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/jarvis_text_dim"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Великий перемикач -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/mainSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:minHeight="72dp"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="Джарвіс вимкнено"
            android:textColor="@color/jarvis_text"
            android:textSize="20sp"
            android:textStyle="bold"
            app:thumbTint="@color/jarvis_on_cyan"
            app:trackTint="@color/jarvis_cyan" />

        <TextView
            android:id="@+id/warningText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_banner"
            android:padding="12dp"
            android:textColor="@color/jarvis_amber"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            style="@style/Jarvis.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ЧУЮ" />

        <TextView
            android:id="@+id/heardText"
            style="@style/Jarvis.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:minHeight="48dp"
            android:text="…"
            android:textColor="@color/jarvis_cyan_dim"
            android:textSize="14sp" />

        <TextView
            style="@style/Jarvis.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="КОМАНДА" />

        <TextView
            android:id="@+id/commandText"
            style="@style/Jarvis.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Jarvis.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ЖУРНАЛ (ОСТАННІ 20)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearLog"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Очистити" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptyLog"
            style="@style/Jarvis.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:text="Тут з'являтимуться виконані команди" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/logList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</ScrollView>
