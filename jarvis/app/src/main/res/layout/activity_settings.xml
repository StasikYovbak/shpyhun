<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hud"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.15"
                android:shadowColor="@color/jarvis_cyan"
                android:shadowRadius="16"
                android:text="НАЛАШТУВАННЯ"
                android:textColor="@color/jarvis_cyan"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============================== СЛОВА -->
        <TextView
            style="@style/Jarvis.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="КЛЮЧОВІ СЛОВА" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Слово активації">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/wakeWord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Як модель іноді чує це слово (через кому)"
            app:helperText="Подивіться на головному екрані в полі «Чую», що виходить, коли ви кажете слово, і допишіть сюди"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/wakeVariants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Слово виконання">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/execWord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Слово скасування">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/cancelWord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/timeoutLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/jarvis_text" />

        <com.google.android.material.slider.Slider
            android:id="@+id/timeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="10"
            android:valueTo="120" />

        <!-- ============================== CLAUDE -->
        <TextView
            style="@style/Jarvis.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="РОЗУМНИЙ РЕЖИМ (CLAUDE)" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/smartMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Невідомі команди відправляти в Claude"
            android:textColor="@color/jarvis_text" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Ключ Claude API (sk-ant-…)"
            app:endIconMode="password_toggle"
            app:helperText="platform.claude.com → Settings → API keys → Create key. Зберігається зашифрованим."
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/claudeKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Модель Claude"
            app:helperText="claude-opus-5-5 — найрозумніша; claude-haiku-5-5 — найшвидша й найдешевша. Можна вписати будь-яку."
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/claudeModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Глибина міркувань (effort)">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/claudeEffort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/fixSongs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Виправляти назви пісень через Claude («білівер» → «Believer»)"
            android:textColor="@color/jarvis_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestClaude"
            style="@style/Jarvis.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Перевірити ключ Claude" />

        <TextView
            android:id="@+id/claudeResult"
            style="@style/Jarvis.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- ============================== YOUTUBE -->
        <TextView
            style="@style/Jarvis.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOUTUBE" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ключ YouTube Data API v3 (AIza…)"
            app:endIconMode="password_toggle"
            app:helperText="console.cloud.google.com → APIs &amp; Services → Credentials → Create credentials → API key"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/youtubeKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestYoutube"
            style="@style/Jarvis.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Перевірити ключ YouTube" />

        <TextView
            android:id="@+id/youtubeResult"
            style="@style/Jarvis.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- ============================== ГОЛОС -->
        <TextView
            style="@style/Jarvis.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ГОЛОС" />

        <TextView
            android:id="@+id/ttsWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_banner"
            android:padding="12dp"
            android:text="На телефоні немає українського голосу. Відкрийте налаштування синтезу мовлення → «Синтезатор Google» → ⚙ → «Встановити голосові дані» → Українська."
            android:textColor="@color/jarvis_amber"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Голос">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/ttsVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Швидкість мовлення"
            android:textColor="@color/jarvis_text" />

        <com.google.android.material.slider.Slider
            android:id="@+id/ttsRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.1"
            android:valueFrom="0.5"
            android:valueTo="2.0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Висота голосу"
            android:textColor="@color/jarvis_text" />

        <com.google.android.material.slider.Slider
            android:id="@+id/ttsPitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.1"
            android:valueFrom="0.5"
            android:valueTo="2.0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreview"
                style="@style/Jarvis.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Прослухати" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTtsSettings"
                style="@style/Jarvis.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Синтез мовлення" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/beep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Звуковий сигнал при активації"
            android:textColor="@color/jarvis_text" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/vibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Вібрація при активації"
            android:textColor="@color/jarvis_text" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sayAck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Казати «Виконую» перед дією"
            android:textColor="@color/jarvis_text" />

        <!-- ============================== РОЗПІЗНАВАННЯ -->
        <TextView
            style="@style/Jarvis.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="РОЗПІЗНАВАННЯ (VOSK, ОФЛАЙН)" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/modelSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/jarvis_text" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/modelNano"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/jarvis_text" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Друга мова для назв пісень"
            app:helperText="Друга модель слухає лише під час запису команди й допомагає Claude вгадати іноземну назву"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/extraLang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/modelsStatus"
            style="@style/Jarvis.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/jarvis_text_dim"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteModels"
            style="@style/Jarvis.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Видалити завантажені моделі" />

        <!-- ============================== ФОН -->
        <TextView
            style="@style/Jarvis.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="РОБОТА У ФОНІ" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBattery"
            style="@style/Jarvis.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Вимкнути оптимізацію батареї" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutostart"
            style="@style/Jarvis.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Автозапуск і «вбивання» у фоні (Xiaomi, Samsung…)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            android:text="Зберегти"
            android:textSize="17sp" />
    </LinearLayout>
</ScrollView>
